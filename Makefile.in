	$(CXXLINK) $(smooth_mesh_OBJECTS) $(smooth_mesh_LDADD) $(LIBS)
testing$(EXEEXT): $(testing_OBJECTS) $(testing_DEPENDENCIES) 
	@rm -f testing$(EXEEXT)
	$(CXXLINK) $(testing_OBJECTS) $(testing_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

